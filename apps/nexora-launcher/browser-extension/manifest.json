{
  "manifest_version": 3,
  "name": "NEXORA Companion",
  "version": "0.4.1",
  "description": "Shares open browser tabs with NEXORA on this device.",
  "key": "",
  "permissions": [
    "alarms",
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Check NEXORA connection"
  }
}
