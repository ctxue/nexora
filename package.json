{
  "name": "nexora-workspace",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "description": "NEXORA multi-product workspace",
  "scripts": {
    "dev:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/products.ps1 -Action dev -Product launcher",
    "dev:isle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/products.ps1 -Action dev -Product isle",
    "debug:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/products.ps1 -Action debug -Product launcher",
    "debug:isle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/products.ps1 -Action debug -Product isle",
    "debug:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/products.ps1 -Action debug -All",
    "test:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/products.ps1 -Action test -Product launcher",
    "test:isle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/products.ps1 -Action test -Product isle",
    "test:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/products.ps1 -Action test -All",
    "package:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/products.ps1 -Action package -Product launcher",
    "package:isle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/products.ps1 -Action package -Product isle",
    "package:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/products.ps1 -Action package -All",
    "release:all": "pnpm package:all",
    "check:workspace": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-workspace-hygiene.ps1",
    "test:workspace": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tests/product-workflow.tests.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-workspace-hygiene.ps1",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-workspace.ps1",
    "clean:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-workspace.ps1 -IncludeDependencies"
  }
}
