{
  "name": "nexora",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "description": "NEXORA — one hub for apps, files, tools and workflows.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:debug": "tauri build --debug --no-bundle",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean.ps1",
    "clean:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean.ps1 -DebugOnly",
    "clean:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean.ps1 -IncludeNodeModules",
    "clean:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean.ps1 -ReleaseOnly",
    "test": "vitest run",
    "test:scripts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tests/release-workflow.tests.ps1",
    "test:watch": "vitest",
    "preview": "vite preview",
    "release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.65.0",
    "motion": "^14.8.0",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
